# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS configuration)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Example local: mongodb://127.0.0.1:27017/imovies
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (Test Mode)
# Get your test API keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_key
